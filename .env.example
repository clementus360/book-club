# Required ---------------------------------------------------------------
# Supabase project URL and publishable (anon) key: Project settings > API keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server only: the secret key (sb_secret_...), shown under "Server". Projects with
# the older keys can set SUPABASE_SERVICE_ROLE_KEY instead. Used for exactly one thing: adding book records that this server
# fetched from Open Library or Google Books to the shared catalogue, so that
# nobody can plant false metadata. Never exposed to the browser.
SUPABASE_SECRET_KEY=

# Where this app lives, no trailing slash. Used in invitation and email links.
# On Vercel it falls back to the production domain if unset.
SITE_URL=http://localhost:3000

# Optional ---------------------------------------------------------------
# Set to 1 after turning on Google under Authentication > Sign In / Providers in
# Supabase (see README). Shows "Continue with Google".
GOOGLE_AUTH=

# Google Books works without a key, but unauthenticated requests share a small
# global quota that is often exhausted. Server only.
GOOGLE_BOOKS_API_KEY=

# Open Library asks regular users of its API to identify themselves. If set,
# this address is included in the User-Agent sent to Open Library.
OPEN_LIBRARY_CONTACT=

# Email at important moments, sent through Resend (resend.com). Both are needed;
# without them nothing is emailed. Server only. EMAIL_FROM must use a domain
# verified in Resend, for example: Commonplace <club@mail.example.com>
RESEND_API_KEY=
EMAIL_FROM=

# Film, TV, anime and game clubs ----------------------------------------
# TV series (TVmaze) and anime (AniList) need no key. Without the keys below,
# film and game clubs still work, but search finds only what members have
# already added or typed in by hand. All server only.
#
# Films: The Movie Database. themoviedb.org > Settings > API: the "API Key".
TMDB_API_KEY=
# Games, either IGDB (preferred; a free Twitch developer application gives
# both values: dev.twitch.tv/console/apps) ...
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# ... or RAWG (rawg.io/apidocs), used only when the Twitch pair is not set.
RAWG_API_KEY=

# Shown on the privacy and terms pages.
CONTACT_EMAIL=

# Overrides for tests only.
# OPEN_LIBRARY_URL=
# GOOGLE_BOOKS_URL=
# RESEND_API_URL=
# TMDB_URL=
# TVMAZE_URL=
# ANILIST_URL=
# TWITCH_TOKEN_URL=
# IGDB_URL=
# RAWG_URL=
# INTERNET_ARCHIVE_URL=
